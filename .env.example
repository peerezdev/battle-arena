VITE_PRIVY_APP_ID=cmp14gng0022w0cl7l4cnmc8g
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_PROGRAM_ID=89qGDjXGcV9zi3968DtRLNzBn5KXhYmSGJkjKntksCdk
VITE_ORACLE_URL=http://localhost:8787
# Mismo origen que el frontend: el proxy de Vite reenvía /gacha, /pack-battles, /ws… al
# backend (:9090 devnet). Apuntar aquí al backend directo se salta el proxy y no funciona.
VITE_BACKEND_URL=http://localhost:5173
# SPL token mint used for battle stakes (e.g. USDC devnet: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU)
VITE_STAKE_MINT=
# Treasury token account that receives the protocol rake (base-58 pubkey of the treasury's SPL token account)
VITE_TREASURY=
# FIX B: Pin the trusted oracle pubkey (base-58). When set, attestations from any other
# oracle pubkey are rejected. Leave empty to skip the check (not recommended for production).
VITE_ORACLE_PUBKEY=
# Collector Crypt collection mint (DAS grouping) used to filter the Inventory tab.
# Default is the mainnet collection; set the devnet collection mint when available.
VITE_CC_COLLECTION_MINT=CCryptWBYktukHDQ2vHGtVcmtjXxYzvw8XNVY64YN2Yf
# Host de imágenes de carta de Collector Crypt. Es POR RED: en mainnet debe ser
# https://nft.collectorcrypt.com o toda carta sale sin imagen (404). Vacío = devnet.
VITE_CC_NFT_BASE=https://nft-dev.collectorcrypt.com
# DAS-capable RPC (Helius) for reading NFTs. Falls back to VITE_SOLANA_RPC.
VITE_DAS_RPC=

# Launch week: wallets (Privy embedded Solana, coma-separadas) que pueden CREAR Battle Royale.
# Vacío = abierto a todos (el frontend requiere rebuild, no solo restart, para reabrir). Debe coincidir con ROYALE_CREATOR_ALLOWLIST del backend.
VITE_ROYALE_CREATOR_ALLOWLIST=

# Redes sociales del rail izquierdo. Vacías = el icono no se pinta.
VITE_DISCORD_URL=
VITE_X_URL=

# Propinas en USDC entre jugadores. APAGADAS por defecto: la funcionalidad está entera y probada,
# pero mueve dinero de verdad y todavía no la ha usado ningún jugador. Para encenderla hay que
# poner "true" AQUÍ y además TIPS_ENABLED=true en backend/.env; el del backend es el que manda.
VITE_TIPS_ENABLED=false
